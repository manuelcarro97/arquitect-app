rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these Google accounts may save projects; anyone else can use the app without saving.
    function isAllowedOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['owner@example.com', 'owner@example.com'];
    }

    match /users/{uid}/{document=**} {
      allow read, write: if isAllowedOwner(uid);
    }
  }
}
